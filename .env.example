# ========================================
# AI Model API Configuration (必需)
# ========================================
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# Data Source API Configuration (可选)
# ========================================
# Alpha Vantage API - 用于获取股票价格（项目已包含本地数据）
ALPHAADVANTAGE_API_KEY=your_alpha_vantage_key_here

# Jina AI API - 用于市场信息搜索
JINA_API_KEY=your_jina_api_key_here

# ========================================
# MCP Service Port Configuration
# ========================================
# 如果端口冲突，可以修改这些端口号
MATH_HTTP_PORT=8000
SEARCH_HTTP_PORT=8001
TRADE_HTTP_PORT=8002
GETPRICE_HTTP_PORT=8003

# ========================================
# AI Agent Configuration
# ========================================
# 最大推理步数
AGENT_MAX_STEP=30

# ========================================
# Runtime Environment Path
# ========================================
# Docker: 使用容器内路径
# 本地: 使用绝对路径
RUNTIME_ENV_PATH=/app/runtime_env.json